{
  "id": "web.peripherals.webxr-immersive",
  "name": "WebXR immersive VR and AR sessions",
  "kind": "permission",
  "group": "peripherals-hardware",
  "subgroup": "XR",
  "tags": [
    "webxr",
    "vr",
    "ar",
    "headset"
  ],
  "plain": "Starts a full VR or AR session on a headset or phone.",
  "meaning": "Streams head and controller pose every frame and, in AR, shows the camera view of the room. Reveals body movement, height and surroundings.",
  "lifecycle": [
    "in-session"
  ],
  "space": "web",
  "platforms": {
    "web": {
      "api": "navigator.xr.isSessionSupported(), requestSession('immersive-vr'|'immersive-ar'|'inline', {requiredFeatures, optionalFeatures})",
      "permission_name": "xr-spatial-tracking",
      "permissions_policy": "xr-spatial-tracking",
      "bcd": [
        "api.XRSystem",
        "api.XRSession",
        "api.XRFrame",
        "api.XRPose"
      ],
      "access": {
        "grant": "prompt",
        "prompt_ui": "Permission bubble for VR or AR tracking; AR may add camera consent",
        "secure_context": true,
        "user_gesture": true,
        "persistence": "Per origin; prompt per session for AR on Chrome",
        "revocation": "Site settings, end session, headset system menu",
        "iframe": "Needs allow=\"xr-spatial-tracking\"",
        "steps": [
          "Check isSessionSupported",
          "Click Enter VR",
          "requestSession() with features",
          "Frame loop via XRSession.requestAnimationFrame"
        ]
      },
      "support": {
        "chrome": {
          "s": "y",
          "v": "79",
          "note": "",
          "date": "2019-12-10"
        },
        "edge": {
          "s": "y",
          "v": "79",
          "note": "",
          "date": "2020-01-15"
        },
        "firefox": {
          "s": "n",
          "v": "",
          "note": "Firefox Desktop dropped support; Meta Quest browser has it"
        },
        "safari": {
          "s": "n",
          "v": "",
          "note": "Safari on visionOS supports immersive-vr; not in BCD"
        },
        "ios_safari": {
          "s": "n",
          "v": "",
          "note": "No WebXR on iPhone or iPad"
        },
        "chrome_android": {
          "s": "y",
          "v": "79",
          "note": "",
          "date": "2019-12-17"
        },
        "samsung": {
          "s": "y",
          "v": "12.0",
          "note": "",
          "date": "2020-06-19"
        }
      }
    }
  },
  "data": {
    "type": "stream",
    "metric": "6DoF poses per frame",
    "update": "per display frame (72 to 120 Hz)",
    "fields": [
      {
        "name": "viewerPose.transform.position",
        "type": "object",
        "unit": "meters",
        "range": "local space, unbounded",
        "precision": "centimetre scale tracking"
      },
      {
        "name": "viewerPose.transform.orientation",
        "type": "object",
        "unit": "quaternion",
        "range": "unit quaternion"
      },
      {
        "name": "inputSources[].gripSpace / targetRaySpace",
        "type": "object",
        "unit": "meters",
        "range": "per controller"
      },
      {
        "name": "boundsGeometry",
        "type": "list",
        "unit": "meters",
        "range": "polygon of playable area",
        "precision": "bounded-floor feature"
      },
      {
        "name": "views[].projectionMatrix",
        "type": "list",
        "range": "4x4 floats"
      }
    ]
  },
  "limits": {
    "headline": "Can start a full VR or AR session after you allow it",
    "user_action": "You tap Enter VR or View in AR and allow the pop up.",
    "can": [
      "Fill your view with a VR scene",
      "Show AR items placed in your room",
      "Track your head and device movement while the session runs"
    ],
    "cannot": [
      "Start without you tapping and allowing",
      "See your surroundings in VR",
      "Keep running after you leave the session",
      "Work in Firefox, Safari or on iPhone"
    ],
    "reach": 2,
    "reach_label": "While the session runs",
    "differs": "Chrome and Edge support it. Safari and Firefox do not."
  },
  "story": {
    "what_it_is": "A page can start a full VR or AR session on a headset or phone.",
