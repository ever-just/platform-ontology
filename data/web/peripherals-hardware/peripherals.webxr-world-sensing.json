{
  "id": "web.peripherals.webxr-world-sensing",
  "name": "WebXR world sensing (hit test, anchors, depth, planes, camera)",
  "kind": "permission",
  "group": "peripherals-hardware",
  "subgroup": "XR",
  "tags": [
    "webxr",
    "ar",
    "depth",
    "planes",
    "camera-access"
  ],
  "plain": "Lets an AR session see surfaces, depth and even raw camera frames of the room.",
  "meaning": "Maps the person's real surroundings: floors, tables, walls, depth and, with camera access, pixels of the room.",
  "lifecycle": [
    "in-session"
  ],
  "space": "web",
  "platforms": {
    "web": {
      "api": "optionalFeatures: hit-test, anchors, depth-sensing, light-estimation, plane-detection, camera-access; frame.detectedPlanes, XRCamera",
      "permission_name": "xr-spatial-tracking",
      "permissions_policy": "xr-spatial-tracking",
      "bcd": [
        "api.XRHitTestSource",
        "api.XRAnchor",
        "api.XRDepthInformation",
        "api.XRPlane",
        "api.XRCamera"
      ],
      "access": {
        "grant": "prompt",
        "prompt_ui": "Chrome shows AR permission; camera-access shows a dedicated camera prompt",
        "secure_context": true,
        "user_gesture": true,
        "persistence": "Per session",
        "revocation": "End session",
        "iframe": "Needs allow=\"xr-spatial-tracking\" (and camera for camera-access)",
        "steps": [
          "Request AR session with features",
          "Per frame query planes, depth and hit tests",
          "camera-access exposes WebGL texture of camera"
        ]
      },
      "support": {
        "chrome": {
          "s": "y",
          "v": "81",
          "note": "Hit test; depth 90; camera access 107; planes 147",
          "date": "2020-04-07"
        },
        "edge": {
          "s": "y",
          "v": "81",
          "note": "Mirrors Chrome",
          "date": "2020-04-13"
        },
        "firefox": {
          "s": "n",
          "v": "",
          "note": ""
        },
        "safari": {
          "s": "n",
          "v": "",
          "note": ""
        },
        "ios_safari": {
          "s": "n",
          "v": "",
          "note": ""
        },
        "chrome_android": {
          "s": "y",
          "v": "81",
          "note": "Mirrors Chrome",
          "date": "2020-04-07"
        },
        "samsung": {
          "s": "y",
          "v": "13.0",
          "note": "XRSystem 12; features partial",
          "date": "2020-12-02"
        }
      }
    }
  },
  "data": {
    "type": "stream",
    "metric": "Surface geometry, depth map, camera texture",
    "update": "per XR frame",
    "fields": [
      {
        "name": "hit result pose",
        "type": "object",
        "unit": "meters",
        "range": "relative to ray",
        "precision": "centimetre"
      },
      {
        "name": "depth map",
        "type": "binary",
        "unit": "millimeters",
        "range": "0 to about 8 m",
        "precision": "16 bit per pixel, 160x90 typical"
      },
      {
        "name": "detectedPlanes[].polygon",
        "type": "list",
        "unit": "meters",
        "range": "convex polygon",
        "precision": "orientation horizontal or vertical"
      },
      {
        "name": "camera view",
        "type": "binary",
        "unit": "pixels",
        "range": "device camera resolution",
        "precision": "RGBA via WebGL texture"
      }
    ]
  },
  "limits": {
    "headline": "Can detect surfaces and depth in your room, and even see camera frames",
    "user_action": "You tap View in AR and allow the AR and camera prompts.",
    "can": [
      "Find floors, walls and tables, so items sit on them",
      "Place items that stay in one spot",
      "Measure depth, and with camera access, see raw camera frames"
    ],
    "cannot": [
      "See raw camera frames unless you allow camera access",
      "Work without your allowing the AR prompt",
      "Keep running after you end the session",
      "Work in Safari, Firefox or on iPhone"
    ],
    "reach": 2,
    "reach_label": "While the AR session runs",
    "differs": "Chrome and Edge on Android support it. Safari and Firefox do not."
  },
  "story": {
    "what_it_is": "In AR, a page can sense your floors, walls and even see your room.",
    "icon": "box",
    "tags": [
      "AR",
      "Camera",
      "Asks first"
    ],
    "marketing": [
      {
        "vendor": "W3C",
        "name": "WebXR Device API",
        "pitch": "The Immersive Web group describes AR features like hit test and anchors that place things in the real world.",
        "url": "https://immersiveweb.dev/"
      }
    ],
    "for_you": "A page places a virtual chair on your floor and keeps it there as you walk. To do that it needs to see your room.",
    "for_makers": "Makers can fit virtual things to real spaces, like furniture and measuring tools. It gives them room shape and sometimes camera pixels, so it is a privacy risk.",
    "use_cases": [
      {
