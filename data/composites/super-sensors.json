    },
    {
      "id": "ctx.calm-ui-preferred",
      "name": "Prefers a calm interface",
      "layer": "L2",
      "plain": "The person has told their device they want less motion, more contrast or less data.",
      "inputs": [
        { "ref": "web.display.prefers-reduced-motion", "role": "evidence", "feature": "reduce", "weight": 2.0, "modality": "environment" },
        { "ref": "web.display.prefers-contrast", "role": "evidence", "feature": "more", "weight": 1.0, "modality": "environment" },
        { "ref": "web.display.forced-colors", "role": "evidence", "feature": "active", "weight": 2.0, "modality": "environment" },
        { "ref": "web.display.prefers-reduced-transparency", "role": "evidence", "feature": "reduce", "weight": 0.8, "modality": "environment" },
        { "ref": "web.display.prefers-reduced-data", "role": "evidence", "feature": "reduce", "weight": 0.8, "modality": "network" }
      ],
      "logic": { "type": "rule", "expr": "any of the media queries true; recompute on change events", "window": "on change" },
      "states": ["calm", "default"],
      "surfaces": { "page": "full", "extension": "full", "mobile": "full" },
      "actions": [ { "do": "Turn off animated charts and auto play", "mode": "auto", "via": "set_param" } ],
      "sensitivity": 2,
      "analogues": ["WCAG 2.3.3 animation from interactions"]
    },
    {
      "id": "intent.about-to-leave",
      "name": "About to leave the page",
      "layer": "L3",
      "plain": "The person is likely to close or leave the page in the next few seconds.",
      "inputs": [
        { "ref": "web.input.pointer-events", "scope": "motion.pointer", "role": "evidence", "feature": "pointer exits through the top edge with upward speed", "weight": 1.5, "modality": "input" },
        { "ref": "web.perf.page-visibility-focus", "scope": "motion.attention", "role": "evidence", "feature": "blur", "weight": 0.8, "modality": "attention" },
        { "ref": "web.xsite.page-lifecycle-events", "role": "evidence", "feature": "pagehide or freeze", "weight": 3.0, "modality": "attention" },
        { "ref": "web.actions.beforeunload", "scope": "reach.leave-warning", "role": "evidence", "feature": "beforeunload fired", "weight": 3.0, "modality": "attention" },
        { "ref": "ctx.context-switching", "role": "prior", "feature": "already switching often", "weight": 0.5, "modality": "attention" }
      ],
      "logic": { "type": "sequence", "expr": "pattern: idle typing > 20 s followedBy pointer exit top followedBy blur, within 5 s; or any beforeunload", "window": "5s" },
      "states": ["staying", "leaving"],
      "surfaces": { "page": "full", "extension": "full", "mobile": "partial" },
      "actions": [ { "do": "Save the draft and session state", "mode": "auto", "via": "reach.leave-warning" } ],
      "sensitivity": 2,
      "analogues": ["exit intent popups", "Flink CEP strict and relaxed contiguity"]
    },
    {
      "id": "intent.ready-for-voice",
      "name": "Ready to talk to the agent",
      "layer": "L3",
      "plain": "A good moment to offer the voice agent: a mic exists, the room is quiet and no call is on.",
      "inputs": [
        { "ref": "web.camera.enumerate-devices", "scope": "surroundings.media_devices", "role": "required", "feature": "mics >= 1", "modality": "device" },
        { "ref": "ctx.surroundings", "role": "evidence", "feature": "quiet", "weight": 1.0, "modality": "audio" },
        { "ref": "ctx.in-call", "role": "veto", "feature": "in a call", "modality": "audio" },
        { "ref": "ctx.motion-mode", "role": "evidence", "feature": "walking or vehicle makes voice better than typing", "weight": 1.0, "modality": "motion" },
        { "ref": "web.perf.page-visibility-focus", "scope": "motion.attention", "role": "required", "feature": "page visible and focused", "modality": "attention" },
        { "ref": "web.perf.idle-detection-user-activation", "role": "required", "feature": "recent user activation (mic start needs a gesture)", "modality": "input" }
      ],
      "logic": { "type": "rule", "expr": "all required true, no veto, and (quiet or moving)", "window": "10s" },
      "states": ["offer_voice", "do_not_offer"],
      "surfaces": { "page": "full", "extension": "full", "mobile": "full" },
      "actions": [ { "do": "Show the talk button", "mode": "suggest", "via": "capture.microphone" } ],
      "sensitivity": 2,
      "analogues": ["docs/research/voice-agents-2026-11.md"]
    },
    {
      "id": "intent.needs-help",
      "name": "Stuck and might want help",
      "layer": "L3",
      "plain": "The person is hesitating: hovering, retyping and rage clicking in one spot.",
      "inputs": [
        { "ref": "web.input.pointer-events", "scope": "motion.pointer", "role": "evidence", "feature": "rage clicks: >= 3 clicks within 1 s inside 30 px", "weight": 1.8, "modality": "input" },
        { "ref": "web.input.keyboard-events", "scope": "motion.keystroke", "role": "evidence", "feature": "backspace_ratio_60s > 0.3", "weight": 1.0, "modality": "input" },
        { "ref": "web.perf.mouse-dynamics", "scope": "motion.pointer", "role": "evidence", "feature": "dwell over one control > 8 s without click", "weight": 0.8, "modality": "input" },
        { "ref": "web.perf.event-timing-inp", "role": "veto", "feature": "INP > 500 ms: the page is slow, not the person", "modality": "device" },
        { "ref": "ctx.fatigue-risk", "role": "prior", "feature": "tiring", "weight": 0.4, "modality": "input" }
      ],
      "logic": { "type": "log_odds", "expr": "p = sigmoid(-3 + sum(weight * present)); veto on slow page", "window": "60s/5s", "enter": 0.8, "exit": 0.4, "min_dwell": "5s" },
      "states": ["fine", "stuck"],
      "surfaces": { "page": "full", "extension": "full", "mobile": "partial" },
      "actions": [ { "do": "Offer the agent with the control in question as context", "mode": "suggest", "via": "describe_capability" } ],
      "sensitivity": 3,
      "analogues": ["session replay frustration signals (rage clicks)"]
    }
  ]
