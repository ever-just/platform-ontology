{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/build-site.sh",
  "outputDirectory": "site",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai.platformontology.lol"
        }
      ],
      "destination": "/ai/ai.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "api.platformontology.lol"
        }
      ],
      "destination": "/api/v1"
    },
    {
      "source": "/v1",
      "has": [
        {
          "type": "host",
          "value": "api.platformontology.lol"
        }
      ],
      "destination": "/api/v1"
    },
    {
      "source": "/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "api.platformontology.lol"
        }
      ],
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/mcp",
      "has": [
        {
          "type": "host",
          "value": "api.platformontology.lol"
        }
      ],
      "destination": "/api/mcp"
    }
  ]
}
